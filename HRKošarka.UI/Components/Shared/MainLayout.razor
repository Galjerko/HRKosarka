@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<MudThemeProvider @ref="@_mudThemeProvider" Theme="@_currentTheme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (_userMenuOpen)
    {
        <div class="appbar-overlay" @onclick="CloseUserMenu"></div>
    }
    <MudAppBar Elevation="0" Class="custom-appbar" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle"
                       Class="menu-button"
                       Size="Size.Medium" />

        <MudText Typo="Typo.h6" Class="app-title ml-3">HRKošarka</MudText>
        <MudSpacer />

        <AuthorizeView>
            <Authorized Context="authCtx">
                <div class="appbar-avatar-wrap">
                    <MudAvatar Color="Color.Primary"
                               Size="Size.Medium"
                               Style="cursor:pointer;font-weight:700;"
                               @onclick="ToggleUserMenu">
                        @(authCtx.User.Identity?.Name?.ToUpperInvariant().FirstOrDefault() ?? 'U')
                    </MudAvatar>
                    @if (_userMenuOpen)
                    {
                        <div class="appbar-user-dropdown">
                            <div class="appbar-user-dropdown-name">
                                <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                                         Size="Size.Small" Color="Color.Primary" Class="mr-2 flex-shrink-0" />
                                <span>@authCtx.User.Identity?.Name</span>
                            </div>
                            <MudDivider />
                            <button class="appbar-logout-row"
                                    @onclick="@(() => { CloseUserMenu(); NavigationManager.NavigateTo("/logout"); })">
                                <MudIcon Icon="@Icons.Material.Filled.Logout"
                                         Size="Size.Small" Color="Color.Error" Class="mr-2" />
                                <span>Logout</span>
                            </button>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="auth-button mr-3">
                    Login
                </MudButton>
                <MudButton Href="/register"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           Class="auth-button">
                    Register
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="1"
               Variant="DrawerVariant.Mini"
               OpenMiniOnHover="true"
               Class="custom-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="custom-main-content">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="main-container">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
