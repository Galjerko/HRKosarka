@using HRKošarka.UI.Services.Base
@using MudBlazor
@inherits HRKošarka.UI.Components.Base.PermissionBaseComponent

<MudDialog Class="playoff-gen-dialog">
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Set the playoff start date and configure how many wins a team needs to advance in each round.
        </MudText>

        <div class="playoff-gen-row mb-4">
            <MudText Typo="Typo.subtitle2" Class="playoff-gen-label">Start Date</MudText>
            <MudDatePicker @bind-Date="_playoffStartDate"
                           Label="Game 1 date"
                           MinDate="@MinStartDate"
                           DateFormat="dd.MM.yyyy."
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           PickerVariant="PickerVariant.Dialog"
                           Style="max-width: 200px"
                           HelperText="@(MinStartDate.HasValue ? $"Earliest: {MinStartDate.Value:dd.MM.yyyy.}" : null)" />
        </div>

        @foreach (var round in _rounds)
        {
            <div class="playoff-gen-row mb-3">
                <MudText Typo="Typo.subtitle2" Class="playoff-gen-label">@round.RoundName</MudText>
                <MudNumericField T="int"
                                 @bind-Value="round.WinsNeeded"
                                 Min="2" Max="4"
                                 Label="Wins to advance"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Style="max-width: 140px" />
            </div>
        }

        @if (PlayoffTeamCount >= 4)
        {
            <div class="playoff-gen-row mb-3">
                <MudText Typo="Typo.subtitle2" Class="playoff-gen-label">3rd Place Match</MudText>
                <MudSwitch @bind-Value="_include3rdPlace" Color="Color.Primary" Label="@(_include3rdPlace ? "Yes" : "No")" />
            </div>
        }

        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
            Generating the playoff bracket is permanent and cannot be undone.
        </MudAlert>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AccountTree"
                   Disabled="@_saving"
                   OnClick="Submit">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Generate Bracket
        </MudButton>
    </DialogActions>
</MudDialog>
