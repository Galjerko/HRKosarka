@page "/teams/{id:guid}"
@using MudBlazor
@using HRKošarka.UI.Services.Base
@using HRKošarka.UI.Components.Base
@inherits HRKošarka.UI.Components.Base.PermissionBaseComponent

<PageTitle>Team Details - Basketball Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="details-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6">Loading team details...</MudText>
        </div>
    }
    else if (_team != null)
    {
        <MudPaper Class="details-paper" Elevation="2">
            <div class="details-actions-row">
                <div class="details-actions-group">
                    <AuditHistory DateCreated="@_team.DateCreated"
                                  DateModified="@_team.DateModified"
                                  DateDeleted="@_team.DateDeleted"
                                  CreatedBy="@_team.CreatedBy"
                                  ModifiedBy="@_team.ModifiedBy"
                                  DeletedBy="@_team.DeletedBy" />

                    @if (CurrentPermissions.CanEdit || _isRepForThisTeam)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() =>
                                   {
                                       _newTeamName = _team.Name;
                                       _showRenameDialog = true;
                                   })"
                                   Class="action-btn details-action-btn">
                            Edit
                        </MudButton>

                        @if (_team.IsActive)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Pause"
                                       OnClick="DeactivateTeam"
                                       Disabled="@_isProcessing"
                                       Class="action-btn details-action-btn">
                                Deactivate
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="ActivateTeam"
                                       Disabled="@_isProcessing"
                                       Class="action-btn details-action-btn">
                                Activate
                            </MudButton>
                        }
                    }

                    @if (CurrentPermissions.CanDelete)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteTeam"
                                   Disabled="@_isProcessing"
                                   Class="action-btn details-action-btn">
                            Delete
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo("/teams"))"
                               Class="action-btn details-action-btn back-action-btn">
                        Back
                    </MudButton>
                </div>
            </div>

            <div class="team-info-row">
                <MudText Typo="Typo.h3" Class="team-name">@_team.Name</MudText>
                <MudChip T="string"
                         Color="@(_team.IsActive ? Color.Success : Color.Error)"
                         Size="Size.Small"
                         Class="status-chip">
                    @(_team.IsActive ? "Active" : "Inactive")
                </MudChip>
            </div>

            <MudDivider Class="my-4" />

            <MudExpansionPanels Elevation="0" Class="expansion-panels" MultiExpansion="true">
                <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="panel-icon" />
                            <MudText Typo="Typo.h6">Basic Information</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="info-grid">
                            <div class="info-row">
                                <div class="info-item">
                                    <MudText Class="info-label">Team Name</MudText>
                                    <MudText Class="info-value">@_team.Name</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Club</MudText>
                                    <MudText Class="info-value">@(_team.ClubName ?? "N/A")</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Age Category</MudText>
                                    <MudText Class="info-value">@(_team.AgeCategoryName ?? "N/A")</MudText>
                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-item">
                                    <MudText Class="info-label">Gender</MudText>
                                    <MudText Class="info-value">
                                        @(_team.Gender == HRKošarka.UI.Services.Base.Gender._0 ? "Male" : "Female")
                                    </MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Status</MudText>
                                    <MudText Class="info-value" Color="@(_team.IsActive ? Color.Success : Color.Error)">
                                        @(_team.IsActive
                                            ? "Active"
                                            : $"Deactivated on {_team.DeactivateDate?.ToString("dd/MM/yyyy")}")
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.People" Class="panel-icon" />
                            <MudText Typo="Typo.h6">Current Roster (@_roster.Count players)</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="d-flex justify-space-between align-center mb-3">
                            @if (CurrentPermissions.CanEdit || _isRepForThisTeam)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="OpenAssignPlayerDialog"
                                           Size="Size.Small">
                                    Assign Player
                                </MudButton>
                            }
                        </div>

                        @if (_isLoadingRoster)
                        {
                            <div class="d-flex justify-center pa-4">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            </div>
                        }
                        else if (!_roster.Any())
                        {
                            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">
                                No players currently assigned to this team.
                            </MudText>
                        }
                        else
                        {
                            <div class="details-scroll-xy">
                                <table class="details-table" style="min-width: 580px">
                                    <thead>
                                        <tr>
                                            <th style="width: 34px">#</th>
                                            <th>Player</th>
                                            <th style="width: 82px">Reg. #</th>
                                            <th style="width: 84px">DOB</th>
                                            <th style="width: 82px">Position</th>
                                            <th style="width: 70px">Season</th>
                                            <th style="width: 84px">Joined</th>
                                            @if (CurrentPermissions.CanEdit || _isRepForThisTeam)
                                            {
                                                <th style="width: 72px">Actions</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var player in _roster)
                                        {
                                            <tr>
                                                <td style="text-align: center">@(player.JerseyNumber?.ToString() ?? "-")</td>
                                                <td><MudLink Href="@($"/players/{player.PlayerId}")">@player.PlayerFirstName @player.PlayerLastName</MudLink></td>
                                                <td>@player.RegistrationNumber</td>
                                                <td>@player.DateOfBirth.ToString("dd.MM.yyyy.")</td>
                                                <td>@GetPositionLabel(player.Position)</td>
                                                <td>@player.SeasonName</td>
                                                <td>@player.JoinDate.ToString("dd.MM.yyyy.")</td>
                                                @if (CurrentPermissions.CanEdit || _isRepForThisTeam)
                                                {
                                                    <td>
                                                        <MudTooltip Text="Edit jersey number">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                           Color="Color.Primary"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => EditPlayerAssignment(player))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Remove from team">
                                                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                           Color="Color.Error"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => RemovePlayer(player))" />
                                                        </MudTooltip>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="panel-icon" />
                            <MudText Typo="Typo.h6">
                                Competition Registrations
                                @if (_leagues.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">@_leagues.Count</MudChip>
                                }
                            </MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (_isLoadingLeagues)
                        {
                            <div class="d-flex justify-center pa-4">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            </div>
                        }
                        else if (!_leagues.Any())
                        {
                            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">
                                This team is not registered in any competition.
                            </MudText>
                        }
                        else
                        {
                            var leagueOnly  = _leagues.Where(l => l.CompetitionType == CompetitionType._0).ToList();
                            var cupOnly     = _leagues.Where(l => l.CompetitionType == CompetitionType._1).ToList();
                            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="mb-2">
                                <MudTabPanel Text="@($"Leagues ({leagueOnly.Count})")" Icon="@Icons.Material.Filled.EmojiEvents">
                                    @if (!leagueOnly.Any())
                                    {
                                        <MudText Typo="Typo.body2" Class="pa-3" Color="Color.Secondary">No league registrations.</MudText>
                                    }
                                    else
                                    {
                                        <div class="details-scroll-x">
                                            <table class="details-table" style="min-width: 360px">
                                                <thead>
                                                    <tr>
                                                        <th>League</th>
                                                        <th style="width: 74px">Season</th>
                                                        <th style="width: 88px">Registered</th>
                                                        <th style="width: 70px">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in leagueOnly)
                                                    {
                                                        <tr>
                                                            <td><MudLink Href="@($"/leagues/{item.LeagueId}")">@item.LeagueName</MudLink></td>
                                                            <td>@item.SeasonName</td>
                                                            <td>@item.RegistrationDate.ToString("dd.MM.yyyy.")</td>
                                                            <td>
                                                                <MudChip T="string" Size="Size.Small" Color="@(item.IsLeagueActive ? Color.Success : Color.Default)">
                                                                    @(item.IsLeagueActive ? "Active" : "Inactive")
                                                                </MudChip>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </MudTabPanel>
                                <MudTabPanel Text="@($"Cups ({cupOnly.Count})")" Icon="@Icons.Material.Filled.WorkspacePremium">
                                    @if (!cupOnly.Any())
                                    {
                                        <MudText Typo="Typo.body2" Class="pa-3" Color="Color.Secondary">No cup registrations.</MudText>
                                    }
                                    else
                                    {
                                        <div class="details-scroll-x">
                                            <table class="details-table" style="min-width: 360px">
                                                <thead>
                                                    <tr>
                                                        <th>Cup</th>
                                                        <th style="width: 74px">Season</th>
                                                        <th style="width: 88px">Registered</th>
                                                        <th style="width: 70px">Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in cupOnly)
                                                    {
                                                        <tr>
                                                            <td><MudLink Href="@($"/leagues/{item.LeagueId}")">@item.LeagueName</MudLink></td>
                                                            <td>@item.SeasonName</td>
                                                            <td>@item.RegistrationDate.ToString("dd.MM.yyyy.")</td>
                                                            <td>
                                                                <MudChip T="string" Size="Size.Small" Color="@(item.IsLeagueActive ? Color.Success : Color.Default)">
                                                                    @(item.IsLeagueActive ? "Active" : "Inactive")
                                                                </MudChip>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </MudTabPanel>
                            </MudTabs>
                        }
                    </ChildContent>
                </MudExpansionPanel>

                <MudExpansionPanel Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="panel-icon" />
                            <MudText Typo="Typo.h6">Player Statistics</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (!_leagues.Any())
                        {
                            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">
                                This team has no competition registrations yet.
                            </MudText>
                        }
                        else
                        {
                            var seasons = _leagues.Select(l => l.SeasonName).Distinct().OrderByDescending(s => s).ToList();
                            var leaguesForSeason = _leagues.Where(l => l.SeasonName == _statsSelectedSeason).ToList();

                            <div class="d-flex align-center gap-3 mb-4" style="flex-wrap:wrap;width:fit-content">
                                <MudSelect T="string"
                                           Label="Season"
                                           Value="_statsSelectedSeason"
                                           ValueChanged="OnSeasonChanged"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Style="min-width:160px;max-width:220px">
                                    @foreach (var s in seasons)
                                    {
                                        <MudSelectItem Value="@s">@s</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect T="Guid?"
                                           Label="Competition"
                                           Value="_statsSelectedLeagueId"
                                           ValueChanged="OnLeagueChanged"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Style="min-width:200px;max-width:320px">
                                    @foreach (var l in leaguesForSeason)
                                    {
                                        <MudSelectItem Value="@((Guid?)l.LeagueId)">@l.LeagueName</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (_teamStanding != null)
                            {
                                <div class="season-combined-card pa-3 mb-3">
                                    <div class="season-combined-label mb-2">TEAM RECORD</div>
                                    <div class="stats-grid" style="grid-template-columns: repeat(4, 1fr); gap: 6px;">
                                        <div class="stat-chip">
                                            <span class="stat-value">@_teamStanding.GamesPlayed</span>
                                            <span class="stat-label">GP</span>
                                        </div>
                                        <div class="stat-chip">
                                            <span class="stat-value" style="color:var(--mud-palette-success)">@_teamStanding.Wins</span>
                                            <span class="stat-label">W</span>
                                        </div>
                                        <div class="stat-chip">
                                            <span class="stat-value" style="color:var(--mud-palette-error)">@_teamStanding.Losses</span>
                                            <span class="stat-label">L</span>
                                        </div>
                                        <div class="stat-chip">
                                            <span class="stat-value">@_teamStanding.LeaguePoints</span>
                                            <span class="stat-label">PTS</span>
                                        </div>
                                    </div>
                                    <div class="season-total-pts mt-2">
                                        @_teamStanding.PointsFor scored · @_teamStanding.PointsAgainst conceded ·
                                        <span style="color:@(_teamStanding.PointsDifference >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)")">
                                            @(_teamStanding.PointsDifference >= 0 ? "+" : "")@_teamStanding.PointsDifference
                                        </span>
                                    </div>
                                    <div class="season-total-pts">
                                        <strong>#@_teamStanding.Position</strong> in standings
                                    </div>
                                </div>
                            }

                            @if (_isLoadingPlayerStats)
                            {
                                <div class="d-flex justify-center pa-4">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                </div>
                            }
                            else if (!_playerStats.Any())
                            {
                                <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">
                                    No stats recorded for this competition yet.
                                </MudText>
                            }
                            else
                            {
                                <div class="player-stats-list">
                                    @foreach (var p in _playerStats)
                                    {
                                        <div class="season-league-card pa-3 mb-2">
                                            <MudLink Href="@($"/players/{p.PlayerId}")" Typo="Typo.subtitle2" Class="d-block mb-2" Style="font-weight:700">
                                                @p.PlayerName
                                            </MudLink>
                                            <div class="stats-grid four-cols">
                                                <div class="stat-chip">
                                                    <span class="stat-value">@p.GamesPlayed</span>
                                                    <span class="stat-label">GP</span>
                                                </div>
                                                <div class="stat-chip">
                                                    <span class="stat-value">@p.Ppg.ToString("F1")</span>
                                                    <span class="stat-label">PPG</span>
                                                </div>
                                                <div class="stat-chip">
                                                    <span class="stat-value">@p.ThreePG.ToString("F1")</span>
                                                    <span class="stat-label">3PG</span>
                                                </div>
                                                <div class="stat-chip">
                                                    <span class="stat-value">@p.Fpg.ToString("F1")</span>
                                                    <span class="stat-label">FPG</span>
                                                </div>
                                            </div>
                                            <div class="season-total-pts mt-1">
                                                @p.TotalPoints pts · @p.TotalThreePointers 3PT · @p.TotalFouls fouls in @p.GamesPlayed GP
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>

                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <MudExpansionPanel Class="expansion-panel">
                            <TitleContent>
                                <div class="panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="panel-icon" />
                                    <MudText Typo="Typo.h6">Representatives (@_representatives.Count active)</MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="d-flex justify-space-between align-center mb-3">
                                    @if (CurrentPermissions.CanEdit)
                                    {
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                                   OnClick="OpenAssignRepDialog"
                                                   Size="Size.Small">
                                            Assign Representative
                                        </MudButton>
                                    }
                                </div>
                                @if (_isLoadingReps)
                                {
                                    <div class="d-flex justify-center pa-4">
                                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                    </div>
                                }
                                else if (!_representatives.Any())
                                {
                                    <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">
                                        No representatives assigned to this team.
                                    </MudText>
                                }
                                else
                                {
                                    <div class="details-scroll-x">
                                        <table class="details-table" style="min-width: 320px">
                                            <thead>
                                                <tr>
                                                    <th>User</th>
                                                    <th style="width: 88px">Assigned</th>
                                                    <th style="width: 70px">Status</th>
                                                    @if (CurrentPermissions.CanEdit)
                                                    {
                                                        <th style="width: 44px"></th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var rep in _representatives)
                                                {
                                                    <tr>
                                                        <td>@rep.UserEmail</td>
                                                        <td>@rep.AssignedDate.ToString("dd.MM.yyyy.")</td>
                                                        <td>
                                                            <MudChip T="string" Size="Size.Small"
                                                                     Color="@(rep.IsActive ? Color.Success : Color.Default)">
                                                                @(rep.IsActive ? "Active" : "Revoked")
                                                            </MudChip>
                                                        </td>
                                                        @if (CurrentPermissions.CanEdit)
                                                        {
                                                            <td>
                                                                @if (rep.IsActive)
                                                                {
                                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonOff"
                                                                                   Color="Color.Error"
                                                                                   Size="Size.Small"
                                                                                   Title="Revoke"
                                                                                   OnClick="@(() => RevokeRep(rep))"
                                                                                   Disabled="_isProcessing" />
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    </Authorized>
                </AuthorizeView>

                <MudExpansionPanel Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.SportsBasketball" Class="panel-icon" />
                            <MudText Typo="Typo.h6">
                                Match History
                                @if (_matchHistory.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@_matchHistory.Count</MudChip>
                                }
                            </MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (_isLoadingMatchHistory)
                        {
                            <div class="d-flex justify-center pa-4">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            </div>
                        }
                        else if (!_matchHistory.Any())
                        {
                            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">No matches played yet.</MudText>
                        }
                        else
                        {
                            @foreach (var season in _matchHistory.GroupBy(m => m.SeasonName).OrderByDescending(g => g.Key))
                            {
                                <div class="tmh-season-header">@season.Key</div>
                                @foreach (var league in season.GroupBy(m => m.LeagueName).OrderBy(g => g.Key))
                                {
                                    <div class="tmh-league-label">
                                        <MudLink Href="@($"/leagues/{league.First().LeagueId}/schedule")" Class="tmh-league-link">
                                            @league.Key
                                        </MudLink>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-1">
                                            @(league.First().CompetitionType == CompetitionType._0 ? "League" : "Cup")
                                        </MudChip>
                                    </div>
                                    <div class="details-scroll-xy">
                                        <table class="details-table" style="min-width: 520px">
                                            <thead>
                                                <tr>
                                                    <th style="width: 88px">Date</th>
                                                    <th style="width: 70px">Round</th>
                                                    <th style="width: 32px">H/A</th>
                                                    <th>Opponent</th>
                                                    <th style="width: 90px">Venue</th>
                                                    <th style="width: 62px; text-align: center">Score</th>
                                                    <th style="width: 74px; text-align: center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var match in league.OrderByDescending(m => m.ScheduledDate).ToList())
                                                {
                                                    var won        = match.TeamScore > match.OpponentScore;
                                                    var lost       = match.TeamScore < match.OpponentScore;
                                                    var hasScore   = match.TeamScore.HasValue && match.OpponentScore.HasValue;
                                                    var isFinished = match.Status == MatchStatus._2 || match.Status == MatchStatus._3;
                                                    var (statusLabel, statusColor) = (isFinished, won, lost) switch
                                                    {
                                                        (true, true, _)      => ("W", Color.Success),
                                                        (true, _, true)      => ("L", Color.Error),
                                                        (true, false, false) => ("D", Color.Default),
                                                        _ when match.Status == MatchStatus._1 => ("Rescheduled", Color.Warning),
                                                        _ => ("Upcoming", Color.Default)
                                                    };
                                                    <tr class="clickable-row"
                                                        @onclick="@(() => NavigationManager.NavigateTo($"/matches/{match.MatchId}"))">
                                                        <td>@match.ScheduledDate.ToString("dd.MM.yyyy.")</td>
                                                        <td style="color:var(--mud-palette-text-secondary);font-size:0.82rem">@match.RoundName</td>
                                                        <td style="text-align:center">
                                                            <span class="tmh-ha @(match.IsHome ? "tmh-ha-home" : "tmh-ha-away")">
                                                                @(match.IsHome ? "H" : "A")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <MudLink Href="@($"/teams/{match.OpponentTeamId}")"
                                                                     @onclick:stopPropagation="true">
                                                                @match.OpponentTeamName
                                                            </MudLink>
                                                        </td>
                                                        <td style="color:var(--mud-palette-text-secondary);font-size:0.8rem">
                                                            @if (!string.IsNullOrEmpty(match.Venue))
                                                            {
                                                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" Style="vertical-align:middle;font-size:0.85rem" />@match.Venue
                                                            }
                                                            else
                                                            {
                                                                <span>–</span>
                                                            }
                                                        </td>
                                                        <td style="text-align:center;font-weight:700;font-variant-numeric:tabular-nums">
                                                            @if (hasScore)
                                                            {
                                                                <span class="@(won ? "tmh-score-win" : lost ? "tmh-score-loss" : "")">@match.TeamScore</span>
                                                                <span class="tmh-score-sep mx-1">:</span>
                                                                <span class="@(lost ? "tmh-score-win" : won ? "tmh-score-loss" : "")">@match.OpponentScore</span>
                                                            }
                                                            else
                                                            {
                                                                <span style="color:var(--mud-palette-text-secondary)">–</span>
                                                            }
                                                        </td>
                                                        <td style="text-align:center">
                                                            <MudChip T="string" Size="Size.Small" Color="@statusColor"
                                                                     Variant="@(isFinished ? Variant.Filled : Variant.Outlined)">
                                                                @statusLabel
                                                            </MudChip>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudPaper>
    }
    else
    {
        <div class="error-state">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h5" Color="Color.Error">Team Not Found</MudText>
            <MudText Typo="Typo.body1">The team you're looking for doesn't exist or has been removed.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => NavigationManager.NavigateTo("/teams"))">
                Back to Teams
            </MudButton>
        </div>
    }
</MudContainer>

<ConfirmActionDialog Visible="_showDeactivateDialog"
                     VisibleChanged="v => _showDeactivateDialog = v"
                     Title="Confirm Deactivation"
                     TitleIcon="@Icons.Material.Filled.PauseCircle"
                     TitleIconColor="Color.Warning"
                     Message="@(DeactivateMessage)"
                     SecondaryMessage="This action can be reversed later."
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL"
                     CancelVariant="Variant.Outlined"
                     ConfirmText="DEACTIVATE"
                     ConfirmIcon="@Icons.Material.Filled.Pause"
                     ConfirmColor="Color.Warning"
                     ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing"
                     OnConfirm="ConfirmDeactivate"
                     Options="_dialogOptions" />

<ConfirmActionDialog Visible="_showActivateDialog"
                     VisibleChanged="v => _showActivateDialog = v"
                     Title="Confirm Activation"
                     TitleIcon="@Icons.Material.Filled.PlayCircle"
                     TitleIconColor="Color.Success"
                     Message="@(ActivateMessage)"
                     SecondaryMessage="This action will make the team active again."
                     SecondaryMessageColor="Color.Success"
                     CancelText="CANCEL"
                     CancelVariant="Variant.Outlined"
                     ConfirmText="ACTIVATE"
                     ConfirmIcon="@Icons.Material.Filled.PlayArrow"
                     ConfirmColor="Color.Success"
                     ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing"
                     OnConfirm="ConfirmActivate"
                     Options="_dialogOptions" />

<ConfirmActionDialog Visible="_showDeleteDialog"
                     VisibleChanged="v => _showDeleteDialog = v"
                     Title="Confirm Deletion"
                     TitleIcon="@Icons.Material.Filled.Warning"
                     TitleIconColor="Color.Error"
                     Message="@(DeleteMessage)"
                     SecondaryMessage="This action cannot be undone!"
                     SecondaryMessageColor="Color.Error"
                     CancelText="CANCEL"
                     CancelVariant="Variant.Outlined"
                     ConfirmText="DELETE"
                     ConfirmIcon="@Icons.Material.Filled.Delete"
                     ConfirmColor="Color.Error"
                     ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing"
                     OnConfirm="ConfirmDelete"
                     Options="_dialogOptions" />

<ConfirmActionDialog Visible="_showRemovePlayerDialog"
                     VisibleChanged="v => _showRemovePlayerDialog = v"
                     Title="Confirm Player Removal"
                     TitleIcon="@Icons.Material.Filled.PersonRemove"
                     TitleIconColor="Color.Error"
                     Message="@($"Are you sure you want to remove <strong>{_playerToRemove?.PlayerFirstName} {_playerToRemove?.PlayerLastName}</strong> from the team?")"
                     SecondaryMessage="This will end their active assignment."
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL"
                     CancelVariant="Variant.Outlined"
                     ConfirmText="REMOVE"
                     ConfirmIcon="@Icons.Material.Filled.PersonRemove"
                     ConfirmColor="Color.Error"
                     ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing"
                     OnConfirm="ConfirmRemovePlayer"
                     Options="_dialogOptions" />

<MudDialog @bind-Visible="_showRenameDialog"
           Options="_dialogOptions"
           Class="confirm-action-dialog">
    <DialogContent>
        <div class="confirm-dialog-content">
            <div class="confirm-dialog-title-row">
                <MudIcon Icon="@Icons.Material.Filled.Edit"
                         Color="Color.Primary"
                         Size="Size.Medium"
                         Class="confirm-dialog-title-icon" />
                <MudText Typo="Typo.h6" Class="confirm-dialog-title-text">
                    Rename Team
                </MudText>
            </div>

            <MudText Typo="Typo.body2" Class="confirm-dialog-message">
                Current name: <strong>@_team?.Name</strong>
            </MudText>

            <MudTextField @bind-Value="_newTeamName"
                          Label="New team name"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Name is required"
                          MaxLength="150"
                          Counter="150" Immediate="true"
                          Class="w-100" />
        </div>
    </DialogContent>

    <DialogActions>
        <div class="confirm-dialog-actions">
            <MudButton OnClick="@(() => _showRenameDialog = false)"
                       Color="Color.Default"
                       Variant="Variant.Outlined"
                       Size="Size.Medium"
                       Class="confirm-dialog-btn">
                CANCEL
            </MudButton>

            <MudButton OnClick="ConfirmRename"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_isRenaming || string.IsNullOrWhiteSpace(_newTeamName)"
                       Class="confirm-dialog-btn">
                @if (_isRenaming)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                <MudText>SAVE</MudText>
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
