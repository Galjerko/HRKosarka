@page "/players/edit/{id:guid}"
@using HRKošarka.UI.Services.Base
@using HRKošarka.UI.Components.Base
@using Microsoft.AspNetCore.Authorization
@inherits HRKošarka.UI.Components.Base.PermissionBaseComponent

<PageTitle>Edit Player - Basketball Management</PageTitle>

<AuthorizeView Roles="Administrator">
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Small" Class="form-page-container">
            @if (_isLoading)
            {
                <div class="loading-state">
                    <MudProgressCircular Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.h6">Loading player details...</MudText>
                </div>
            }
            else if (_player == null)
            {
                <MudPaper Class="form-card">
                    <div class="error-state">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
                        <MudText Typo="Typo.h5" Color="Color.Error">Player Not Found</MudText>
                        <MudText Typo="Typo.body1">The player you're trying to edit doesn't exist or has been removed.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@(() => NavigationManager.NavigateTo("/players"))">
                            Back to Players
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="form-card club-form-card">
                    <div class="form-header">
                        <MudAvatar Size="Size.Large" Class="form-icon-avatar">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" />
                        </MudAvatar>
                        <MudText Typo="Typo.h4" Class="form-title">Edit Player</MudText>
                        <MudText Typo="Typo.h6" Class="form-subtitle">Update player information</MudText>
                    </div>

                    <MudForm @ref="_form" @bind-IsValid="@_isFormValid">
                        <MudGrid Spacing="4">

                            <MudItem xs="12">
                                <ImageUpload Label="Player Photo"
                                             InitialImageName="_player?.ImageName"
                                             InitialImageContentType="_player?.ImageContentType"
                                             InitialImageBytes="_player?.ImageBytes"
                                             OnImageChanged="OnImageChanged" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Class="section-title">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="section-icon" />
                                    Personal Information
                                </MudText>
                                <MudDivider Class="section-divider" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.FirstName"
                                              Label="First Name"
                                              Variant="Variant.Text"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Person"
                                              Required="true"
                                              RequiredError="First name is required"
                                              Counter="100" Immediate="true"
                                              MaxLength="100"
                                              Validation="@(new Func<string, IEnumerable<string>>(ValidateFirstName))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.LastName"
                                              Label="Last Name"
                                              Variant="Variant.Text"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Person"
                                              Required="true"
                                              RequiredError="Last name is required"
                                              Counter="100" Immediate="true"
                                              MaxLength="100"
                                              Validation="@(new Func<string, IEnumerable<string>>(ValidateLastName))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_model.RegistrationNumber"
                                              Label="Registration Number"
                                              Variant="Variant.Text"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Badge"
                                              Required="true"
                                              RequiredError="Registration number is required"
                                              Validation="@(new Func<string, IEnumerable<string>>(ValidateRegistrationNumber))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudDatePicker Date="_dateOfBirth"
                                               DateChanged="@(value => _dateOfBirth = value)"
                                               Label="Date of Birth"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               DateFormat="dd.MM.yyyy."
                                               Editable="true"
                                               Adornment="Adornment.Start"
                                               AdornmentIcon="@Icons.Material.Filled.Cake"
                                               Required="true"
                                               RequiredError="Date of birth is required"
                                               MaxDate="@DateTime.Today.AddDays(-1)"
                                               OpenTo="OpenTo.Year"
                                               Validation="@(new Func<DateTime?, IEnumerable<string>>(ValidateDateOfBirth))" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           @bind-Value="_model.Nationality"
                                           Label="Nationality"
                                           Variant="Variant.Text"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.Flag"
                                           Dense="true"
                                           Clearable="true">
                                    @foreach (var country in _countries)
                                    {
                                        <MudSelectItem T="string" Value="@country">@country</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.h6" Class="section-title">
                                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Class="section-icon" />
                                    Physical & Sport Information
                                </MudText>
                                <MudDivider Class="section-divider" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudSelect T="HRKošarka.UI.Services.Base.Position"
                                           @bind-Value="_model.Position"
                                           Label="Position"
                                           Variant="Variant.Text"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.SportsBasketball"
                                           Dense="true">
                                    <MudSelectItem Value="@HRKošarka.UI.Services.Base.Position._0">Point Guard</MudSelectItem>
                                    <MudSelectItem Value="@HRKošarka.UI.Services.Base.Position._1">Shooting Guard</MudSelectItem>
                                    <MudSelectItem Value="@HRKošarka.UI.Services.Base.Position._2">Small Forward</MudSelectItem>
                                    <MudSelectItem Value="@HRKošarka.UI.Services.Base.Position._3">Power Forward</MudSelectItem>
                                    <MudSelectItem Value="@HRKošarka.UI.Services.Base.Position._4">Center</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudNumericField @bind-Value="_model.Height"
                                                 Label="Height (cm)"
                                                 Variant="Variant.Text"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.Height"
                                                 Min="100"
                                                 Max="250"
                                                 Step="1"
                                                 Validation="@(new Func<int?, IEnumerable<string>>(ValidateHeight))" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudNumericField @bind-Value="_model.Weight"
                                                 Label="Weight (kg)"
                                                 Variant="Variant.Text"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.MonitorWeight"
                                                 Min="30"
                                                 Max="200"
                                                 Step="1"
                                                 Validation="@(new Func<int?, IEnumerable<string>>(ValidateWeight))" />
                            </MudItem>

                            <MudItem xs="12" Class="form-actions">
                                <MudButton OnClick="HandleSubmit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@(_isProcessing || !_isFormValid)"
                                           Class="action-button">
                                    @if (_isProcessing)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Updating Player...</MudText>
                                    }
                                    else
                                    {
                                        <MudText>Update Player</MudText>
                                    }
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           Size="Size.Large"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/players/{Id}"))"
                                           Disabled="@_isProcessing"
                                           Class="action-button ml-4">
                                    Cancel
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudPaper>
            }
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
