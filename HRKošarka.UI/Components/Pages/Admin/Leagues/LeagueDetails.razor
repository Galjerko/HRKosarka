@page "/leagues/{Id:guid}"
@using HRKošarka.UI.Services.Base
@using HRKošarka.UI.Components.Pages.Dialogs
@inherits HRKošarka.UI.Components.Base.PermissionBaseComponent

<PageTitle>League Details - Basketball Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="details-container">
    @if (_isLoading)
    {
        <div class="loading-state">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6">Loading league details...</MudText>
        </div>
    }
    else if (_league != null)
    {
        <MudPaper Class="details-paper" Elevation="2">

            <div class="details-actions-row">
                <div class="details-actions-group">

                    <AuditHistory DateCreated="@_league.DateCreated"
                                  DateModified="@_league.DateModified"
                                  DateDeleted="@_league.DateDeleted"
                                  CreatedBy="@_league.CreatedBy"
                                  ModifiedBy="@_league.ModifiedBy"
                                  DeletedBy="@_league.DeletedBy" />

                    <AuthorizeView Roles="Administrator">
                        <Authorized>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => NavigationManager.NavigateTo($"/admin/leagues/{Id}/edit"))"
                                       Class="action-btn details-action-btn">
                                Edit
                            </MudButton>

                            @if (_league.IsActive)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Pause"
                                           OnClick="@(() => _showDeactivateDialog = true)"
                                           Disabled="_isProcessing"
                                           Class="action-btn details-action-btn">
                                    Deactivate
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="@(() => _showActivateDialog = true)"
                                           Disabled="_isProcessing"
                                           Class="action-btn details-action-btn">
                                    Activate
                                </MudButton>
                            }

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => _showDeleteDialog = true)"
                                       Disabled="@(_isProcessing || _league.ScheduleGenerated)"
                                       Class="action-btn details-action-btn">
                                Delete
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => NavigationManager.NavigateTo("/leagues"))"
                               Class="action-btn details-action-btn back-action-btn">
                        Back
                    </MudButton>

                </div>
            </div>

            <div class="details-info-row">
                <div class="logo-wrapper">
                    @if (_league.ImageBytes != null && _league.ImageBytes.Length > 0
                                    && !string.IsNullOrEmpty(_league.ImageContentType))
                    {
                        var base64 = Convert.ToBase64String(_league.ImageBytes);
                        var src = $"data:{_league.ImageContentType};base64,{base64}";
                        <MudImage Src="@src" Alt="@_league.Name" Class="logo-image" />
                    }
                    else
                    {
                        <MudAvatar Class="logo-fallback">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                        </MudAvatar>
                    }
                </div>

                <MudText Typo="Typo.h3" Class="details-name">@_league.Name</MudText>

                <div class="d-flex gap-2 align-center flex-wrap">
                    <MudChip T="string"
                             Color="@(_league.IsActive ? Color.Success : Color.Error)"
                             Size="Size.Small"
                             Class="status-chip">
                        @(_league.IsActive ? "Active" : "Inactive")
                    </MudChip>
                    @if (_league.ScheduleGenerated)
                    {
                        @if (IsTournamentFinished)
                        {
                            <MudChip T="string"
                                     Color="Color.Success"
                                     Size="Size.Small"
                                     Icon="@Icons.Material.Filled.EmojiEvents">
                                Finished
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Color="Color.Info"
                                     Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Lock">
                                Schedule Generated
                            </MudChip>
                        }
                    }
                </div>
            </div>

            <MudDivider Class="my-4" />

            <MudExpansionPanels Elevation="0" Class="expansion-panels" MultiExpansion="true">

                <!-- Basic Information -->
                <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="panel-icon" />
                            <MudText Typo="Typo.h6">Basic Information</MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="info-grid">
                            <div class="info-row">
                                <div class="info-item">
                                    <MudText Class="info-label">League Name</MudText>
                                    <MudText Class="info-value">@_league.Name</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Season</MudText>
                                    <MudText Class="info-value">@_league.SeasonName</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Age Category</MudText>
                                    <MudText Class="info-value">@_league.AgeCategoryCode</MudText>
                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-item">
                                    <MudText Class="info-label">Gender</MudText>
                                    <MudText Class="info-value">@_league.Gender.ToDisplayString()</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Competition Type</MudText>
                                    <MudText Class="info-value">@_league.CompetitionType.ToDisplayString()</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Format</MudText>
                                    <MudText Class="info-value">@(_league.NumberOfRounds == 1 ? "Single Round Robin" : "Double Round Robin")</MudText>
                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-item">
                                    <MudText Class="info-label">Start Date</MudText>
                                    <MudText Class="info-value">@_league.StartDate.ToString("dd.MM.yyyy.")</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">End Date</MudText>
                                    <MudText Class="info-value">@_league.EndDate.ToString("dd.MM.yyyy.")</MudText>
                                </div>
                                <div class="info-item">
                                    <MudText Class="info-label">Status</MudText>
                                    <MudText Class="info-value" Color="@(_league.IsActive ? Color.Success : Color.Error)">
                                        @(_league.IsActive ? "Active" : $"Deactivated on {_league.DeactivateDate?.ToString("dd.MM.yyyy.")}")
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>

                <!-- Registered Teams -->
                <MudExpansionPanel Class="expansion-panel">
                    <TitleContent>
                        <div class="panel-title">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Class="panel-icon" />
                            <MudText Typo="Typo.h6">
                                Registered Teams
                                @if (_leagueTeams.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">@_leagueTeams.Count</MudChip>
                                }
                                @if (_league.ScheduleGenerated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Lock" Class="ml-2">Locked</MudChip>
                                }
                            </MudText>
                            @if (_league.ScheduleGenerated)
                            {
                                <div class="ml-auto" @onclick:stopPropagation="true">
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               EndIcon="@Icons.Material.Filled.ArrowForward"
                                               OnClick="@(() => NavigationManager.NavigateTo($"/leagues/{Id}/schedule"))">
                                        <span class="view-schedule-label">View Schedule</span>
                                        <span class="view-schedule-icon-only">Schedule</span>
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @if (!_league.ScheduleGenerated)
                        {
                            <AuthorizeView Roles="Administrator">
                                <Authorized>
                                    @if (_league.IsActive)
                                    {
                                        <div class="mb-3">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.GroupAdd"
                                                       OnClick="OpenRegisterTeamDialog"
                                                       Size="Size.Small">
                                                Register Team
                                            </MudButton>
                                        </div>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                Team registration is locked — the schedule has been generated.
                            </MudAlert>
                        }

                        @if (_isLoadingTeams)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        }
                        else if (!_leagueTeams.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No teams registered in this league yet.</MudText>
                        }
                        else
                        {
                            <div class="teams-scroll-wrapper">
                                <table class="teams-native-table">
                                    <thead>
                                        <tr>
                                            <th>Team</th>
                                            <th>Club</th>
                                            <th>Age Category</th>
                                            <th>Registration Date</th>
                                            @if (!_league.ScheduleGenerated)
                                            {
                                                <AuthorizeView Roles="Administrator" Context="hdrCtx">
                                                    <Authorized><th></th></Authorized>
                                                </AuthorizeView>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var team in _leagueTeams)
                                        {
                                            <tr>
                                                <td><MudLink Href="@($"/teams/{team.TeamId}")">@team.TeamName</MudLink></td>
                                                <td>@team.ClubName</td>
                                                <td>@team.AgeCategoryName</td>
                                                <td>@team.RegistrationDate.ToString("dd.MM.yyyy.")</td>
                                                @if (!_league.ScheduleGenerated)
                                                {
                                                    <AuthorizeView Roles="Administrator" Context="authCtx">
                                                        <Authorized>
                                                            <td>
                                                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                                               Color="Color.Error"
                                                                               Size="Size.Small"
                                                                               OnClick="@(() => RemoveTeam(team))"
                                                                               Disabled="_isProcessing" />
                                                            </td>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </ChildContent>
                </MudExpansionPanel>

                <!-- Breaks & Schedule Generation (admin, pre-generation) -->
                @if (!_league.ScheduleGenerated)
                {
                    <AuthorizeView Roles="Administrator">
                        <Authorized>
                            <MudExpansionPanel Class="expansion-panel">
                                <TitleContent>
                                    <div class="panel-title">
                                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="panel-icon" />
                                        <MudText Typo="Typo.h6">
                                            Breaks
                                            @if (_breaks.Any())
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">@_breaks.Count</MudChip>
                                            }
                                        </MudText>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    @if (_isLoadingBreaks)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                    else
                                    {
                                        @if (_breaks.Any())
                                        {
                                            <div class="details-scroll-x mb-4">
                                                <table class="details-table" style="min-width: 320px">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th style="width: 90px">Start</th>
                                                            <th style="width: 90px">End</th>
                                                            <th style="width: 44px"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var b in _breaks)
                                                        {
                                                            <tr>
                                                                <td>@b.Name</td>
                                                                <td>@b.StartDate.ToString("dd.MM.yyyy.")</td>
                                                                <td>@b.EndDate.ToString("dd.MM.yyyy.")</td>
                                                                <td>
                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                                   Color="Color.Error"
                                                                                   Size="Size.Small"
                                                                                   OnClick="@(() => RemoveBreak(b))" />
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                                No breaks defined. The schedule will be generated without any skip weeks.
                                            </MudText>
                                        }

                                        <!-- Add break inline form -->
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Add Break</MudText>
                                        <div class="d-flex gap-3 align-end flex-wrap">
                                            <MudTextField @bind-Value="_breakName"
                                                          Label="Break Name"
                                                          Placeholder="e.g. Winter Break"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Class="break-name-input" />
                                            <MudDatePicker Date="_breakStartDate"
                                                           DateChanged="@(v => _breakStartDate = v)"
                                                           Label="Start Date"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           DateFormat="dd.MM.yyyy."
                                                           Editable="true"
                                                           MinDate="@_league.StartDate"
                                                           MaxDate="@_league.EndDate"
                                                           Class="break-date-input" />
                                            <MudDatePicker Date="_breakEndDate"
                                                           DateChanged="@(v => _breakEndDate = v)"
                                                           Label="End Date"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           DateFormat="dd.MM.yyyy."
                                                           Editable="true"
                                                           MinDate="@(_breakStartDate ?? _league.StartDate)"
                                                           MaxDate="@_league.EndDate"
                                                           Class="break-date-input" />
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="AddBreak"
                                                       Disabled="_isAddingBreak"
                                                       Size="Size.Medium">
                                                @if (_isAddingBreak)
                                                {
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                }
                                                Add
                                            </MudButton>
                                        </div>
                                    }

                                    <MudDivider Class="my-4" />

                                    <!-- Generate Schedule / Cup Draw button -->
                                    @if (_leagueTeams.Count >= 2)
                                    {
                                        var isCup = _league.CompetitionType == CompetitionType._1;
                                        <div class="d-flex flex-column gap-2">
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Ready to generate: <strong>@_leagueTeams.Count teams</strong>,
                                                <strong>@_breaks.Count break(s)</strong> defined.
                                                @(isCup
                                                    ? "Round 1 matches will be drawn randomly. Subsequent rounds are created automatically after each round is confirmed."
                                                    : "Matches will be scheduled every Saturday at 19:00, skipping break weeks.")
                                            </MudText>
                                            <MudAlert Severity="Severity.Warning" Dense="true">
                                                Once generated, team registration will be locked and cannot be undone.
                                            </MudAlert>
                                            <div>
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Success"
                                                           StartIcon="@Icons.Material.Filled.CalendarMonth"
                                                           OnClick="@(() => _showGenerateScheduleDialog = true)"
                                                           Disabled="_isProcessing">
                                                    @(isCup ? "Generate Cup Draw" : "Generate Schedule")
                                                </MudButton>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">
                                            Register at least 2 teams before generating the schedule.
                                        </MudAlert>
                                    }
                                </ChildContent>
                            </MudExpansionPanel>
                        </Authorized>
                    </AuthorizeView>
                }

                <!-- Schedule (post-generation) -->
                @if (_league.ScheduleGenerated)
                {
                    <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                        <TitleContent>
                            <div class="panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="panel-icon" />
                                <MudText Typo="Typo.h6">
                                    Match Schedule
                                    @if (_schedule.Any())
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">
                                            @_schedule.Sum(r => r.Matches.Count) matches
                                        </MudChip>
                                    }
                                </MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @if (_isLoadingSchedule)
                            {
                                <div class="d-flex justify-center pa-4">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                </div>
                            }
                            else if (!_schedule.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No matches found.</MudText>
                            }
                            else
                            {
                                <div class="schedule-scroll">
                                @foreach (var round in _schedule)
                                {
                                    <div class="mb-4">
                                        <div class="d-flex align-center gap-3 mb-2">
                                            <MudText Typo="Typo.subtitle1" Class="round-name">
                                                @round.RoundName
                                            </MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @round.ScheduledDate.ToString("dd.MM.yyyy. HH:mm")
                                            </MudText>
                                        </div>
                                        <div class="schedule-container">
                                            <div class="schedule-header-row">
                                                <div class="match-col-home">Home</div>
                                                <div class="match-col-sep"></div>
                                                <div class="match-col-away">Away</div>
                                                <div class="match-col-venue">Venue</div>
                                                <div class="match-col-status">Status</div>
                                            </div>
                                            @foreach (var matchCtx in round.Matches)
                                            {
                                                <a href="@($"/matches/{matchCtx.Id}")" class="match-row match-row-link">
                                                    <div class="match-col-home">
                                                        <span class="match-team-link">@matchCtx.HomeTeamName</span>
                                                    </div>
                                                    <div class="match-col-sep">
                                                        @if (matchCtx.HomeScore.HasValue && matchCtx.AwayScore.HasValue)
                                                        {
                                                            <span class="match-score @(matchCtx.HomeScore > matchCtx.AwayScore ? "match-score-win" : matchCtx.HomeScore < matchCtx.AwayScore ? "match-score-loss" : "")">@matchCtx.HomeScore</span>
                                                            <span class="match-score-colon"> : </span>
                                                            <span class="match-score @(matchCtx.AwayScore > matchCtx.HomeScore ? "match-score-win" : matchCtx.AwayScore < matchCtx.HomeScore ? "match-score-loss" : "")">@matchCtx.AwayScore</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="match-result-placeholder">–</span>
                                                        }
                                                    </div>
                                                    <div class="match-col-away">
                                                        <span class="match-team-link">@matchCtx.AwayTeamName</span>
                                                    </div>
                                                    <div class="match-col-venue" title="@matchCtx.Venue">@matchCtx.Venue</div>
                                                    <div class="match-col-status">
                                                        <MudChip T="string" Size="Size.Small" Color="@matchCtx.Status.ToColor()">
                                                            @matchCtx.Status.ToDisplayString()
                                                        </MudChip>
                                                    </div>
                                                </a>
                                            }
                                            @{ var byeTeam = GetByeTeam(round); }
                                            @if (byeTeam is not null)
                                            {
                                                <div class="bye-notice">
                                                    <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Size="Size.Small" />
                                                    <MudLink Href="@($"/teams/{byeTeam.TeamId}")" Class="match-team-link">@byeTeam.TeamName</MudLink>
                                                    <span class="match-result-placeholder">– Bye (no match this round)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <MudDivider Class="mb-3" />
                                }
                                </div>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }

                <!-- Standings (post-generation) -->
                @if (_league.ScheduleGenerated)
                {
                    <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                        <TitleContent>
                            <div class="panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.Leaderboard" Class="panel-icon" />
                                <MudText Typo="Typo.h6">Standings</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @if (_isLoadingStandings)
                            {
                                <div class="d-flex justify-center pa-4">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                </div>
                            }
                            else if (_standings == null || !_standings.Standings.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No standings data yet.</MudText>
                            }
                            else
                            {
                                <div class="standings-scroll-wrapper">
                                    <table class="standings-native-table">
                                        <thead>
                                            <tr>
                                                <th class="standings-col-pos">#</th>
                                                <th class="standings-col-team">Team</th>
                                                <th class="standings-col-stat">GP</th>
                                                <th class="standings-col-stat">W</th>
                                                <th class="standings-col-stat">L</th>
                                                <th class="standings-col-stat">PF</th>
                                                <th class="standings-col-stat">PA</th>
                                                <th class="standings-col-stat">+/-</th>
                                                <th class="standings-col-stat">Pts</th>
                                                <th class="standings-col-last5">Last 5</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in _standings.Standings)
                                            {
                                                <tr class="standings-row">
                                                    <td class="standings-col-pos">@row.Position</td>
                                                    <td class="standings-col-team">
                                                        <MudLink Href="@($"/teams/{row.TeamId}")">@row.TeamName</MudLink>
                                                    </td>
                                                    @if (row.HasPlayed)
                                                    {
                                                        <td class="standings-col-stat">@row.GamesPlayed</td>
                                                        <td class="standings-col-stat">@row.Wins</td>
                                                        <td class="standings-col-stat">@row.Losses</td>
                                                        <td class="standings-col-stat">@row.PointsFor</td>
                                                        <td class="standings-col-stat">@row.PointsAgainst</td>
                                                        <td class="standings-col-stat @(row.PointsDifference > 0 ? "standings-positive" : row.PointsDifference < 0 ? "standings-negative" : "")">
                                                            @(row.PointsDifference > 0 ? $"+{row.PointsDifference}" : row.PointsDifference.ToString())
                                                        </td>
                                                        <td class="standings-col-stat standings-pts">@row.LeaguePoints</td>
                                                        <td class="standings-col-last5">
                                                            <div class="d-flex gap-1 flex-nowrap">
                                                                @foreach (var result in row.Last5)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small"
                                                                             Color="@(result == "W" ? Color.Success : Color.Error)"
                                                                             Class="last5-chip">
                                                                        @result
                                                                    </MudChip>
                                                                }
                                                            </div>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="standings-col-stat standings-no-games" colspan="8">No games played</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                            }
                        </ChildContent>
                    </MudExpansionPanel>

                    @if (_standings?.Leaders != null)
                    {
                        <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                            <TitleContent>
                                <div class="panel-title">
                                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="panel-icon" />
                                    <MudText Typo="Typo.h6">League Leaders</MudText>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="leaders-grid">

                                    <div class="leaders-card">
                                        <div class="leaders-card-header leaders-header-scorers">
                                            <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2"><strong>Top Scorers</strong></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-auto">PPG</MudChip>
                                        </div>
                                        <div class="leaders-table-scroll"><table class="leaders-table">
                                            <thead>
                                                <tr>
                                                    <th class="ldr-th-player">Player</th>
                                                    <th class="ldr-th-team">Team</th>
                                                    <th class="ldr-th-gp">GP</th>
                                                    <th class="ldr-th-val">PPG</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var entry in _standings.Leaders.TopScorers)
                                                {
                                                    <tr class="ldr-row">
                                                        <td class="ldr-td-player"><MudLink Href="@($"/players/{entry.PlayerId}")">@entry.PlayerName</MudLink></td>
                                                        <td class="ldr-td-team">@entry.TeamName</td>
                                                        <td class="ldr-td-gp">@entry.GamesPlayed</td>
                                                        <td class="ldr-td-val">@entry.Value.ToString("F1")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table></div>
                                    </div>

                                    <div class="leaders-card">
                                        <div class="leaders-card-header leaders-header-threes">
                                            <MudIcon Icon="@Icons.Material.Filled.Looks3" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2"><strong>Three-Pointers</strong></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-auto">3PG</MudChip>
                                        </div>
                                        <div class="leaders-table-scroll"><table class="leaders-table">
                                            <thead>
                                                <tr>
                                                    <th class="ldr-th-player">Player</th>
                                                    <th class="ldr-th-team">Team</th>
                                                    <th class="ldr-th-gp">GP</th>
                                                    <th class="ldr-th-val">3PG</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var entry in _standings.Leaders.TopThreePointers)
                                                {
                                                    <tr class="ldr-row">
                                                        <td class="ldr-td-player"><MudLink Href="@($"/players/{entry.PlayerId}")">@entry.PlayerName</MudLink></td>
                                                        <td class="ldr-td-team">@entry.TeamName</td>
                                                        <td class="ldr-td-gp">@entry.GamesPlayed</td>
                                                        <td class="ldr-td-val">@entry.Value.ToString("F1")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table></div>
                                    </div>

                                    <div class="leaders-card">
                                        <div class="leaders-card-header leaders-header-fouls">
                                            <MudIcon Icon="@Icons.Material.Filled.PanTool" Size="Size.Small" />
                                            <MudText Typo="Typo.subtitle2"><strong>Foul Leaders</strong></MudText>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-auto">FPG</MudChip>
                                        </div>
                                        <div class="leaders-table-scroll"><table class="leaders-table">
                                            <thead>
                                                <tr>
                                                    <th class="ldr-th-player">Player</th>
                                                    <th class="ldr-th-team">Team</th>
                                                    <th class="ldr-th-gp">GP</th>
                                                    <th class="ldr-th-val">FPG</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var entry in _standings.Leaders.TopFoulMakers)
                                                {
                                                    <tr class="ldr-row">
                                                        <td class="ldr-td-player"><MudLink Href="@($"/players/{entry.PlayerId}")">@entry.PlayerName</MudLink></td>
                                                        <td class="ldr-td-team">@entry.TeamName</td>
                                                        <td class="ldr-td-gp">@entry.GamesPlayed</td>
                                                        <td class="ldr-td-val">@entry.Value.ToString("F1")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table></div>
                                    </div>

                                </div>
                                <div class="d-flex justify-end mt-2">
                                    <MudLink Href="@($"/leagues/{_league.Id}/leaderboard")" Typo="Typo.body2">
                                        Full Leaderboard →
                                    </MudLink>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                }

                @if (_league.HasPlayoff && _league.ScheduleGenerated)
                {
                    <MudExpansionPanel IsInitiallyExpanded="true" Class="expansion-panel">
                        <TitleContent>
                            <div class="panel-title">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="panel-icon" />
                                <MudText Typo="Typo.h6">Playoff Bracket</MudText>
                                @if (_league.PlayoffGenerated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">Generated</MudChip>
                                }
                            </div>
                        </TitleContent>
                        <ChildContent>
                            @if (!_league.PlayoffGenerated)
                            {
                                <AuthorizeView Roles="Administrator">
                                    <Authorized>
                                        @if (_league.AllRegularMatchesComplete)
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                                Regular season is complete. You can now generate the playoff bracket.
                                            </MudAlert>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Warning"
                                                       StartIcon="@Icons.Material.Filled.AccountTree"
                                                       OnClick="OpenGeneratePlayoffDialog"
                                                       Disabled="_isProcessing">
                                                Generate Playoff Bracket
                                            </MudButton>
                                        }
                                        else
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                All regular-season matches must be completed before generating the playoff.
                                            </MudAlert>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            }
                            else if (_isLoadingBracket)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                            }
                            else if (_bracketError != null)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true">@_bracketError</MudAlert>
                            }
                            else if (_bracket != null)
                            {
                                <div class="playoff-bracket">
                                    @foreach (var round in _bracket.Rounds)
                                    {
                                        <div>
                                            <div class="playoff-round-header">
                                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;text-transform:uppercase;letter-spacing:0.06em;opacity:0.6;font-size:0.8rem">
                                                    @round.RoundName
                                                </MudText>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Round @round.RoundNumber</MudChip>
                                            </div>
                                            <div class="playoff-series-list">
                                                @foreach (var series in round.Series)
                                                {
                                                    <div class="playoff-series-card @(series.IsCompleted ? "psc-completed" : "")">
                                                        <div class="psc-header">
                                                            <div class="psc-team @(series.WinnerId == series.HomeTeamId ? "psc-winner" : "")">
                                                                @if (series.HomeSeedNumber.HasValue)
                                                                {
                                                                    <span class="psc-seed">#@series.HomeSeedNumber</span>
                                                                }
                                                                @if (series.HomeTeamId.HasValue && series.HomeTeamName != null)
                                                                {
                                                                    <MudLink Href="@($"/teams/{series.HomeTeamId}")">@series.HomeTeamName</MudLink>
                                                                }
                                                                else
                                                                {
                                                                    <span>TBD</span>
                                                                }
                                                            </div>
                                                            <div class="psc-score-block">
                                                                <span class="psc-wins @(series.HomeWins > series.AwayWins ? "psc-wins-leading" : "")">
                                                                    @series.HomeWins
                                                                </span>
                                                                <span class="psc-dash">–</span>
                                                                <span class="psc-wins @(series.AwayWins > series.HomeWins ? "psc-wins-leading" : "")">
                                                                    @series.AwayWins
                                                                </span>
                                                            </div>
                                                            <div class="psc-team @(series.WinnerId == series.AwayTeamId ? "psc-winner" : "")">
                                                                @if (series.AwaySeedNumber.HasValue)
                                                                {
                                                                    <span class="psc-seed">#@series.AwaySeedNumber</span>
                                                                }
                                                                @if (series.AwayTeamId.HasValue && series.AwayTeamName != null)
                                                                {
                                                                    <MudLink Href="@($"/teams/{series.AwayTeamId}")">@series.AwayTeamName</MudLink>
                                                                }
                                                                else
                                                                {
                                                                    <span>TBD</span>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="psc-footer">
                                                            <span class="psc-bestof">Best of @(series.WinsNeeded * 2 - 1)</span>
                                                            <MudChip T="string" Size="Size.Small"
                                                                     Color="@(series.IsCompleted ? Color.Success : series.Matches.Any() ? Color.Info : Color.Default)">
                                                                @(series.IsCompleted ? "Completed" : series.Matches.Any() ? "In Progress" : "Upcoming")
                                                            </MudChip>
                                                            @if (series.Matches.Any())
                                                            {
                                                                <MudIconButton Size="Size.Small"
                                                                               Icon="@(_expandedSeries.Contains(series.SeriesId) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                                               OnClick="@(() => ToggleSeries(series.SeriesId))" />
                                                            }
                                                        </div>
                                                        @if (_expandedSeries.Contains(series.SeriesId))
                                                        {
                                                            <div class="psc-matches">
                                                                @foreach (var match in series.Matches.OrderBy(m => m.GameNumber))
                                                                {
                                                                    <a href="@($"/matches/{match.MatchId}")" class="psc-match-row">
                                                                        <div class="psc-match-left">
                                                                            @if (!string.IsNullOrEmpty(match.Venue))
                                                                            {
                                                                                <span class="psc-match-venue">@match.Venue</span>
                                                                            }
                                                                            <span class="psc-match-date">@match.ScheduledDate.ToString("dd.MM. HH:mm")</span>
                                                                            <span class="psc-match-num">G@(match.GameNumber)</span>
                                                                        </div>
                                                                        <span class="psc-match-score">
                                                                            @if (match.HomeScore.HasValue)
                                                                            { @match.HomeScore <text> : </text> @match.AwayScore }
                                                                            else { <text>–</text> }
                                                                        </span>
                                                                        <div class="psc-match-right">
                                                                            <MudChip T="string" Size="Size.Small" Color="@match.Status.ToColor()">
                                                                                @match.Status.ToDisplayString()
                                                                            </MudChip>
                                                                        </div>
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }

            </MudExpansionPanels>
        </MudPaper>
    }
    else
    {
        <div class="error-state">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h5" Color="Color.Error">League Not Found</MudText>
            <MudText Typo="Typo.body1">The league you're looking for doesn't exist or has been removed.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => NavigationManager.NavigateTo("/leagues"))">
                Back to Leagues
            </MudButton>
        </div>
    }
</MudContainer>

<ConfirmActionDialog @bind-Visible="_showRemoveTeamDialog"
                     Title="Confirm Remove Team"
                     TitleIcon="@Icons.Material.Filled.PersonRemove"
                     TitleIconColor="Color.Error"
                     Message="@($"Are you sure you want to remove <strong>{_teamToRemove?.TeamName}</strong> from this league?")"
                     SecondaryMessage="The team can be re-registered later."
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="REMOVE" ConfirmIcon="@Icons.Material.Filled.PersonRemove"
                     ConfirmColor="Color.Error" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmRemoveTeam"
                     Options="_dialogOptions" />

<ConfirmActionDialog @bind-Visible="_showRemoveBreakDialog"
                     Title="Remove Break"
                     TitleIcon="@Icons.Material.Filled.EventBusy"
                     TitleIconColor="Color.Warning"
                     Message="@($"Are you sure you want to remove the break <strong>{_breakToRemove?.Name}</strong>?")"
                     SecondaryMessage="This will affect the schedule generation."
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="REMOVE" ConfirmIcon="@Icons.Material.Filled.Delete"
                     ConfirmColor="Color.Error" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmRemoveBreak"
                     Options="_dialogOptions" />

<ConfirmActionDialog @bind-Visible="_showGenerateScheduleDialog"
                     Title="@(_league?.CompetitionType == CompetitionType._1 ? "Generate Cup Draw" : "Generate Schedule")"
                     TitleIcon="@Icons.Material.Filled.CalendarMonth"
                     TitleIconColor="Color.Success"
                     Message="@(_league?.CompetitionType == CompetitionType._1
                         ? $"Generate the cup draw for <strong>{_league?.Name}</strong>?"
                         : $"Generate the match schedule for <strong>{_league?.Name}</strong>?")"
                     SecondaryMessage="@(_league?.CompetitionType == CompetitionType._1
                         ? "This will generate Round 1 matches and lock team registration. Subsequent rounds are created automatically."
                         : "This will lock team registration and cannot be undone.")"
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="GENERATE" ConfirmIcon="@Icons.Material.Filled.CalendarMonth"
                     ConfirmColor="Color.Success" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmGenerateSchedule"
                     Options="_dialogOptions" />

<ConfirmActionDialog @bind-Visible="_showDeactivateDialog"
                     Title="Confirm Deactivation"
                     TitleIcon="@Icons.Material.Filled.PauseCircle"
                     TitleIconColor="Color.Warning"
                     Message="@_deactivateMessage"
                     SecondaryMessage="This action can be reversed later."
                     SecondaryMessageColor="Color.Warning"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="DEACTIVATE" ConfirmIcon="@Icons.Material.Filled.Pause"
                     ConfirmColor="Color.Warning" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmDeactivate"
                     Options="_dialogOptions" />

<ConfirmActionDialog @bind-Visible="_showActivateDialog"
                     Title="Confirm Activation"
                     TitleIcon="@Icons.Material.Filled.PlayCircle"
                     TitleIconColor="Color.Success"
                     Message="@_activateMessage"
                     SecondaryMessage="This action will make the league active again."
                     SecondaryMessageColor="Color.Success"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="ACTIVATE" ConfirmIcon="@Icons.Material.Filled.PlayArrow"
                     ConfirmColor="Color.Success" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmActivate"
                     Options="_dialogOptions" />

<ConfirmActionDialog @bind-Visible="_showDeleteDialog"
                     Title="Confirm Deletion"
                     TitleIcon="@Icons.Material.Filled.Warning"
                     TitleIconColor="Color.Error"
                     Message="@_deleteMessage"
                     SecondaryMessage="This action cannot be undone!"
                     SecondaryMessageColor="Color.Error"
                     CancelText="CANCEL" CancelVariant="Variant.Outlined"
                     ConfirmText="DELETE" ConfirmIcon="@Icons.Material.Filled.Delete"
                     ConfirmColor="Color.Error" ConfirmVariant="Variant.Filled"
                     IsProcessing="_isProcessing" OnConfirm="ConfirmDelete"
                     Options="_dialogOptions" />
