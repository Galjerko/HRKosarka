@page "/admin/email-notifications"
@using HRKošarka.UI.Services.Base
@using HRKošarka.UI.Components.Base
@using HRKošarka.UI.Extensions
@inherits HRKošarka.UI.Components.Base.PermissionBaseComponent

<AuthorizeView Roles="Administrator">
    <Authorized>
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" Class="mb-4">Email notifications</MudText>

            <MudPaper Elevation="2" Class="pa-4 mb-4 team-filter-card" Square="false">
                <div class="team-filters-header">
                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Secondary" Class="mr-2" />
                    <MudText Typo="Typo.h6" Class="team-filters-title">Filter Notifications</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="@(async () => await ResetFilters())"
                               Class="filter-reset-btn">
                        Reset
                    </MudButton>
                </div>
                <div class="team-filters-container">
                    <MudSelect T="NotificationType?" @bind-Value="_notificationTypeFilter"
                               @bind-Value:after="OnFilterChanged"
                               Label="Notification type"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true"
                               Class="team-filter-field">
                        <MudSelectItem T="NotificationType?" Value="@null">All Types</MudSelectItem>
                        @foreach (var type in Enum.GetValues<NotificationType>())
                        {
                            <MudSelectItem T="NotificationType?" Value="@type">@type.ToDisplayString()</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="bool?" @bind-Value="_successFilter"
                               @bind-Value:after="OnFilterChanged"
                               Label="Status"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true"
                               Class="team-filter-field">
                        <MudSelectItem T="bool?" Value="@null">All Status</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-1" Size="Size.Small" />
                            Successful
                        </MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Class="mr-1" Size="Size.Small" />
                            Failed
                        </MudSelectItem>
                    </MudSelect>
                </div>
            </MudPaper>

            <MudTable @ref="_table"
                      ServerData="LoadServerData"
                      Loading="_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      FixedHeader="true"
                      Height="600px">

                <HeaderContent>
                    <MudTh>Sent at</MudTh>
                    <MudTh>Recipient</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Match</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Content</MudTh>
                </HeaderContent>

                <RowTemplate Context="notification">
                    <MudTd DataLabel="Sent at">@notification.SentAt.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Recipient">@notification.RecipientEmail</MudTd>
                    <MudTd DataLabel="Type">@notification.NotificationType.ToDisplayString()</MudTd>
                    <MudTd DataLabel="Match">
                        @if (notification.MatchId.HasValue)
                        {
                            <MudLink Href="@($"/matches/{notification.MatchId}")">View match</MudLink>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@(notification.IsSuccessful ? Color.Success : Color.Error)" Size="Size.Small">
                            @(notification.IsSuccessful ? "Sent" : "Failed")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Content">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       title="View email content"
                                       OnClick="@(() => ViewContent(notification))" />
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">No email notifications found</MudText>
                </NoRecordsContent>

                <LoadingContent>
                    <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">Loading notifications...</MudText>
                </LoadingContent>

                <PagerContent>
                    <MudTablePager Class="styled-dropdown" HidePageNumber="false" PageSizeOptions="@_pageSizeOptions" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>
